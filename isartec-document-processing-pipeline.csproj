<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>isartec_document_processing_pipeline</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.58.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
  </ItemGroup>

<ItemGroup>
  <Compile Remove="DocumentProcessingPipeline.Tests/**/*.cs" />
  <Compile Remove="DocumentProcessingPipeline.Tests/obj/**/*.cs" />
  <Compile Remove="DocumentProcessingPipeline.Tests/bin/**/*.cs" />
</ItemGroup>


</Project>
